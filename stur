local elapsedTime = 0
local statsTimer = 0
local frameCounter = 0
local cachedFps = 60
local renderConn
renderConn = RunService.RenderStepped:Connect(function(dt)
	if not screenGui.Parent then
		renderConn:Disconnect()
		return
	end

	elapsedTime += dt
	statsTimer += dt
	frameCounter += 1

	for _, grad in ipairs(animatedGradients) do
		grad.Rotation = (grad.Rotation + dt * 135) % 360
	end

	if fxLayer.Visible then
		for _, d in ipairs(rainDrops) do
			d.y += dt * d.speed
			d.x -= dt * d.speed * 0.12
			if d.y > 1.05 then d.y = -0.05 end
			if d.x < -0.02 then d.x = 1.02 end
			d.frame.Position = UDim2.new(d.x, 0, d.y, 0)
		end

		for _, s in ipairs(stars) do
			s.frame.BackgroundTransparency = 0.25 + 0.45 * (0.5 + 0.5 * math.sin(elapsedTime * s.speed + s.phase))
		end
	end

	currentSilentAimTarget = GetClosestTargetToCenter()
	fovFrame.Visible = _G.G_SilentAimShowFOV
	fovFrame.Size = UDim2.new(0, _G.G_SilentAimFOV, 0, _G.G_SilentAimFOV)

	if PlayerWidgetActive and AimlockPlayerEnabled and camera then
		if not lockedPlayerTarget or not lockedPlayerTarget:FindFirstChild("HumanoidRootPart") then
			lockedPlayerTarget = getClosestPlayer()
		end
		local hum = lockedPlayerTarget and lockedPlayerTarget:FindFirstChildOfClass("Humanoid")
		if lockedPlayerTarget and hum and hum.Health > 0 then
			local pos = lockedPlayerTarget.HumanoidRootPart.Position + Vector3.new(0, 0.5, 0)
			camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, pos), 0.4)
		else
			lockedPlayerTarget = nil
		end
	else
		lockedPlayerTarget = nil
	end

	if NpcWidgetActive and AimlockNpcEnabled and camera then
		if not lockedNpcTarget or not lockedNpcTarget:FindFirstChild("HumanoidRootPart") then
			lockedNpcTarget = getClosestNPC()
		end
		local hum = lockedNpcTarget and lockedNpcTarget:FindFirstChildOfClass("Humanoid")
		if lockedNpcTarget and hum and hum.Health > 0 then
			local pos = lockedNpcTarget.HumanoidRootPart.Position + Vector3.new(0, 0.5, 0)
			camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, pos), 0.4)
		else
			lockedNpcTarget = nil
		end
	else
		lockedNpcTarget = nil
	end

	if statsTimer >= 0.3 then
		cachedFps = math.clamp(math.floor((frameCounter / statsTimer) + 0.5), 1, 999)
		frameCounter = 0
		statsTimer = 0
		updateStatusAndTarget(cachedFps)
	end
end)

player.CharacterAdded:Connect(function(char)
	monitorCharPortal(char)
	enforceSoru(char)
	if SanguineNoCDEnabled then char:SetAttribute("AllCooldown", 3) end
	if SanguineAutoEnabled then task.wait(0.5); startSanguineAutoWatcher() end
end)

if player.Character then
	monitorCharPortal(player.Character)
	enforceSoru(player.Character)
end

pcall(LoadConfig)
updateWidgetsVisuals()

task.spawn(function()
	local duration = 1.6
	local t0 = os.clock()
	while true do
		local now = os.clock()
		local alpha = math.clamp((now - t0) / duration, 0, 1)
		local pct = math.clamp(math.floor(1 + alpha * 99), 1, 100)
		introPercent.Text = tostring(pct) .. "%"
		introBar.Size = UDim2.new(pct / 100, 0, 1, 0)
		if alpha >= 1 then break end
		task.wait()
	end

	introPercent.Text = "100%"
	introBar.Size = UDim2.new(1, 0, 1, 0)
	task.wait(0.15)

	introFrame.Visible = false
	openTab("Home")
end)
